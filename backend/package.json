{
  "name": "udtabirdie-socials",
  "version": "1.0.0",
  "description": "UdtaBirdie Socials - A modern social media platform with microservices architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:simple": "ts-node src/index.ts",
    "test": "jest --config config/jest.config.js",
    "test:watch": "jest --config config/jest.config.js --watch",
    "test:coverage": "jest --config config/jest.config.js --coverage",
    "test:integration": "ts-node src/test/integration/runTests.ts",
    "test:integration:watch": "nodemon --exec \"npm run test:integration\" --ext ts",
    "test:all": "npm run test && npm run test:integration",
    "lint": "eslint --config config/.eslintrc.js src/**/*.ts",
    "lint:fix": "eslint --config config/.eslintrc.js src/**/*.ts --fix"
  },
  "keywords": [
    "udtabirdie",
    "social-media",
    "social-network",
    "microservices",
    "typescript",
    "node.js",
    "react",
    "community"
  ],
  "author": "Shaishav <sk.shaishav.9@gmail.com> (https://github.com/Shaishav13)",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-slow-down": "^3.0.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.9",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.1",
    "pg": "^8.11.3",
    "rate-limiter-flexible": "^2.4.2",
    "redis": "^4.6.10",
    "typescript": "^5.3.2",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0"
  }
}
